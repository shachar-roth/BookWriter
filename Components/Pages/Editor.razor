    private async Task AddChapterAtEnd()
    {
        if (Scenes.LastOrDefault() is not { } last) return;
        await PrepareStructuralMutation();
        var created = await StoryRepository.CreateChapterAfterAsync(last.Id);
        await Reload(created?.Id);
