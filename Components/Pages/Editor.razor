    private async Task JoinWithPreviousScene(SceneEditorModel scene)
    {
        await PrepareStructuralMutation();
        var sceneIndex = Scenes.IndexOf(scene);
        if (sceneIndex <= 0) return;
        var previous = Scenes[sceneIndex - 1];
        await StoryRepository.JoinWithNextSceneAsync(previous.ToDocument());
        await Reload(previous.Id);
        StatusMessage = "הסצנות חוברו";
    }

    private async Task SplitSceneAtCursor(SceneEditorModel scene)
    {
        var content = await JS.InvokeAsync<string?>("sceneEditor.getSceneValue", scene.Id);
        if (content is null) return;
        scene.Content = content;
        var offset = await JS.InvokeAsync<int>("sceneEditor.getSelectionStart", scene.Id);
        if (offset <= 0 || offset >= content.Length)
        {
            StatusMessage = "יש למקם את הסמן בתוך הטקסט";
            return;
        }
        await StoryRepository.SplitSceneAsync(scene.ToDocument(), offset);
        await Reload(scene.Id);
        OpenMetadataSceneId = null;
        StatusMessage = "הסצנה פוצלה";
    }

    private async Task RemoveChapterDivider(ChapterEditorGroup chapter)
    {
        await PrepareStructuralMutation();
        var chapterIndex = ChapterGroups.IndexOf(chapter);
        if (chapterIndex <= 0) return;
        var previousId = ChapterGroups[chapterIndex - 1].FirstSceneId;
        await StoryRepository.RemoveChapterDividerAsync(chapter.FirstSceneId);
        await Reload(previousId);
        StatusMessage = "מחיצת הפרק נמחקה";
    }

    private async Task RemoveCurrentChapterDivider()
    {
        if (CurrentChapter is not null) await RemoveChapterDivider(CurrentChapter);
    }

    private async Task RenameChapterFromPrompt(ChapterEditorGroup chapter)
    {
        var newName = await JS.InvokeAsync<string?>("sceneEditor.promptChapterName", chapter.Name);
        if (newName is null) return;
        await PrepareStructuralMutation();
        await StoryRepository.RenameChapterAsync(chapter.FirstSceneId, newName);
        await Reload(chapter.FirstSceneId);
        StatusMessage = "שם הפרק עודכן";
    }

    private async Task RenameCurrentChapter()
    {
        if (CurrentChapter is not null) await RenameChapterFromPrompt(CurrentChapter);
    }

    private async Task SaveTimelineChip(SceneEditorModel scene, string value)
    {
        scene.Timeline = value;
        await StoryRepository.SaveSceneMetadataAsync(scene.Id, scene.Timeline, scene.Places);
        await ReloadMetadata();
        StatusMessage = "נתוני הסצנה נשמרו";
    }

    private async Task SaveLocationChip(SceneEditorModel scene, string? entityId, string value)
    {
        var places = GetSceneLocationEntities(scene)
            .Where(location => location.Id != entityId)
            .Select(location => location.Name)
            .ToList();
        if (!string.IsNullOrWhiteSpace(value)) places.Add(value);
        scene.Places = places.Distinct(StringComparer.OrdinalIgnoreCase).ToList();
        await StoryRepository.SaveSceneMetadataAsync(scene.Id, scene.Timeline, scene.Places);
        await ReloadMetadata();
        StatusMessage = "נתוני הסצנה נשמרו";
    }

    private async Task SaveCharacterChip(SceneEditorModel scene, string? entityId, string value)
    {
        var names = GetSceneCharacterEntities(scene)
            .Where(character => character.Id != entityId)
            .Select(character => character.Name)
            .ToList();
        if (!string.IsNullOrWhiteSpace(value)) names.Add(value);
        await StoryRepository.SaveSceneCharactersAsync(scene.Id, names);
        await ReloadMetadata();
        StatusMessage = "נתוני הסצנה נשמרו";
    }

    private async Task ReloadMetadata()
    {
        var workspace = await StoryRepository.LoadWorkspaceAsync();
        CharactersIndex = workspace.CharactersIndex;
        LocationsIndex = workspace.LocationsIndex;
        SceneMetadata = workspace.SceneMetadata;
        TimelineIndex = workspace.TimelineIndex;
        var scenesById = workspace.Scenes.ToDictionary(scene => scene.Id, StringComparer.Ordinal);
        foreach (var scene in Scenes)
        {
            if (!scenesById.TryGetValue(scene.Id, out var updated)) continue;
            scene.Timeline = updated.Timeline;
            scene.Places = [.. updated.Places];
        }
    }

    private async Task AnalyzeMetadataNow(SceneEditorModel scene)
    {
        if (AnalyzingMetadataSceneId is not null) return;
        var totalTimer = Stopwatch.StartNew();
        MetadataAnalysisTiming = null;

        var currentContent = await JS.InvokeAsync<string?>("sceneEditor.getSceneValue", scene.Id);
        if (currentContent is null)
        {
            StatusMessage = "לא ניתן לקרוא את תוכן הסצנה";
            return;
        }

        scene.Content = currentContent;
        AnalyzingMetadataSceneId = scene.Id;
        MetadataAnalysisMessageSceneId = scene.Id;
        MetadataAnalysisMessage = "מנתח את הסצנה...";
        StatusMessage = MetadataAnalysisMessage;
        await JS.InvokeVoidAsync("sceneEditor.setSceneReadOnly", scene.Id, true);
        StateHasChanged();
        await Task.Yield();

        try
        {
            var result = await MetadataProcessor.AnalyzeSceneNowAsync(scene.Id, ComponentCancellation.Token);
            var reloadDuration = TimeSpan.Zero;
            if (result.Success)
            {
                var reloadTimer = Stopwatch.StartNew();
                await Reload(scene.Id);
                reloadTimer.Stop();
                reloadDuration = reloadTimer.Elapsed;
            }
            totalTimer.Stop();
            var preparationDuration = totalTimer.Elapsed - result.AiDuration - result.IndexUpdateDuration - reloadDuration;
            if (preparationDuration < TimeSpan.Zero) preparationDuration = TimeSpan.Zero;
            MetadataAnalysisTiming = new MetadataAnalysisTimingDisplay(
                scene.Id,
                totalTimer.Elapsed,
                preparationDuration,
                result.AiDuration,
                result.IndexUpdateDuration,
                reloadDuration);
            MetadataAnalysisMessage = result.Message;
            StatusMessage = result.Message;
        }
        catch (OperationCanceledException) when (ComponentCancellation.IsCancellationRequested)
        {
        }
        catch
        {
            MetadataAnalysisMessage = "הניתוח נכשל. נסו שוב.";
            StatusMessage = MetadataAnalysisMessage;
        }
        finally
        {
            try { await JS.InvokeVoidAsync("sceneEditor.setSceneReadOnly", scene.Id, false); }
            catch (JSDisconnectedException) { }
            AnalyzingMetadataSceneId = null;
        }
    }

    private async Task FlushAll() => await JS.InvokeVoidAsync("sceneEditor.flushAll");
    private async Task ExportDiagnosticBundle()
    {
        await FlushAll();
        Navigation.NavigateTo("/diagnostics/export", forceLoad: true);
    }
    private async Task PrepareStructuralMutation()
    {
        await FlushAll();
    }

    private async Task StageAgentProposal(AgentProposal proposal)
    {
        await FlushAll();
        if (PendingAgentProposal is { } previous && previous.Id != proposal.Id) previous.IsRejected = true;
        PendingAgentProposal = proposal;
        MarkAgentProposalStaleIfNeeded(proposal);
        LastAppliedProposal = null;
        BuildAgentProposalPreview(proposal);
        StatusMessage = "השינויים המוצעים מוצגים בכתב היד.";
        StateHasChanged();
        await FocusAgentProposal(proposal);
    }

    private async Task FocusAgentProposal(AgentProposal proposal)
    {
        if (proposal.IsRejected || proposal.IsUndone) return;
        if (!proposal.IsApplied)
        {
            PendingAgentProposal = proposal;
            MarkAgentProposalStaleIfNeeded(proposal);
            BuildAgentProposalPreview(proposal);
        }
        else
        {
            LastAppliedProposal = proposal;
            StatusMessage = "השינוי כבר הוחל.";
            return;
        }

        if (AgentReviewSceneIds.Count > 0)
        {
            AgentReviewIndex = Math.Clamp(AgentReviewIndex, 0, AgentReviewSceneIds.Count - 1);
            await JS.InvokeVoidAsync("sceneEditor.scrollToScene", AgentReviewSceneIds[AgentReviewIndex]);
        }
    }

    private void BuildAgentProposalPreview(AgentProposal proposal)
    {
        AgentDiffs.Clear();
        foreach (var operation in proposal.Operations.Where(operation => operation.Kind == AgentOperationKind.ReplaceSceneText))
        {
            var scene = FindScene(operation.SceneId);
            if (scene is not null) AgentDiffs[scene.Id] = AgentDiffService.Build(scene.Content, operation.Content ?? "");
        }

        AgentReviewSceneIds = proposal.Operations
            .Select(operation => FindScene(operation.SceneId) is not null
                ? operation.SceneId
                : FindScene(operation.TargetSceneId ?? "") is not null
                    ? operation.TargetSceneId!
                    : Scenes.LastOrDefault()?.Id)
            .Where(sceneId => !string.IsNullOrWhiteSpace(sceneId))
            .Distinct(StringComparer.Ordinal)
            .Cast<string>()
            .ToList();
        AgentReviewIndex = 0;
    }

    private void MarkAgentProposalStaleIfNeeded(AgentProposal proposal)
    {
        proposal.IsStale = proposal.Operations.Any(operation =>
        {
            if (string.IsNullOrWhiteSpace(operation.ExpectedContentHash)) return false;
            var scene = FindScene(operation.SceneId);
            return scene is null || !string.Equals(
                operation.ExpectedContentHash,
                SceneMetadataRepository.ComputeContentHash(scene.Content),
                StringComparison.Ordinal);
        });
    }

    private async Task ApplyAgentProposal()
    {
        if (PendingAgentProposal is not { } proposal || proposal.IsStale) return;
        if (proposal.Operations.Any(operation => operation.Kind == AgentOperationKind.DeleteScene))
        {
            var confirmed = await JS.InvokeAsync<bool>("confirm", "ההצעה כוללת מחיקת סצנה. להמשיך?");
            if (!confirmed) return;
        }

        await PrepareStructuralMutation();
        var result = await AgentProposals.ApplyAsync(proposal, ComponentCancellation.Token);
        StatusMessage = result.Message;
        if (!result.Success)
        {
            proposal.IsStale = result.IsStale || proposal.IsStale;
            return;
        }

        LastAppliedProposal = proposal;
        PendingAgentProposal = null;
        ClearAgentProposalPreview();
        await Reload(ActiveSceneId);
    }

    private void RejectAgentProposal()
    {
        if (PendingAgentProposal is null) return;
        PendingAgentProposal.IsRejected = true;
        PendingAgentProposal = null;
        ClearAgentProposalPreview();
        StatusMessage = "ההצעה בוטלה.";
    }

    private async Task UndoLastAgentProposal()
    {
        if (LastAppliedProposal is not { } proposal) return;
        await PrepareStructuralMutation();
        var result = await AgentProposals.UndoAsync(proposal, ComponentCancellation.Token);
        StatusMessage = result.Message;
        if (!result.Success) return;
        LastAppliedProposal = null;
        await Reload(ActiveSceneId);
    }

    private async Task PreviousAgentReview()
    {
        if (AgentReviewSceneIds.Count == 0) return;
        AgentReviewIndex = (AgentReviewIndex - 1 + AgentReviewSceneIds.Count) % AgentReviewSceneIds.Count;
        await JS.InvokeVoidAsync("sceneEditor.scrollToScene", AgentReviewSceneIds[AgentReviewIndex]);
    }

    private async Task NextAgentReview()
    {
        if (AgentReviewSceneIds.Count == 0) return;
        AgentReviewIndex = (AgentReviewIndex + 1) % AgentReviewSceneIds.Count;
        await JS.InvokeVoidAsync("sceneEditor.scrollToScene", AgentReviewSceneIds[AgentReviewIndex]);
    }

    private void ClearAgentProposalPreview()
    {
        AgentDiffs.Clear();
        AgentReviewSceneIds = [];
        AgentReviewIndex = 0;
    }

    private string AgentReviewPositionLabel => AgentReviewSceneIds.Count == 0
        ? $"{PendingAgentProposal?.Operations.Count ?? 0} שינויים"
        : $"סצנה {AgentReviewIndex + 1} מתוך {AgentReviewSceneIds.Count}";
    private AgentOperation? GetReplaceOperation(string sceneId) =>
        PendingAgentProposal?.Operations.FirstOrDefault(operation =>
            operation.Kind == AgentOperationKind.ReplaceSceneText && operation.SceneId == sceneId);
    private IReadOnlyList<AgentOperation> GetStructuralOperations(string sceneId) =>
        PendingAgentProposal?.Operations.Where(operation =>
            operation.Kind != AgentOperationKind.ReplaceSceneText &&
            operation.Kind != AgentOperationKind.CreateScene &&
            operation.SceneId == sceneId).ToList() ?? [];
    private IReadOnlyList<AgentOperation> GetCreatedScenesAfter(string? sceneId) =>
        PendingAgentProposal?.Operations.Where(operation =>
            operation.Kind == AgentOperationKind.CreateScene &&
            (sceneId is null
                ? string.IsNullOrWhiteSpace(operation.TargetSceneId)
                : operation.TargetSceneId == sceneId)).ToList() ?? [];
    private string SceneFrameClass(SceneEditorModel scene)
    {
        var classes = new List<string> { "scene-frame" };
        if (IsSceneMetadataOpen(scene)) classes.Add("is-metadata-open");
        if (PendingAgentProposal?.Operations.Any(operation =>
                operation.Kind == AgentOperationKind.DeleteScene && operation.SceneId == scene.Id) == true)
            classes.Add("agent-proposed-delete");
        if (PendingAgentProposal?.Operations.Any(operation => operation.SceneId == scene.Id) == true)
            classes.Add("agent-proposed-change");
        return string.Join(' ', classes);
    }
    private static string DiffSegmentClass(AgentDiffKind kind) => $"diff-segment diff-{kind.ToString().ToLowerInvariant()}";
    private static string DescribeProvisionalOperation(AgentOperation operation) => operation.Kind switch
    {
        AgentOperationKind.DeleteScene => "הסצנה תימחק",
        AgentOperationKind.SplitScene => "הסצנה תפוצל",
        AgentOperationKind.JoinScenes => "הסצנה תחובר לסצנה הבאה",
        AgentOperationKind.MoveScene => "הסצנה תועבר למיקום חדש",
        AgentOperationKind.CreateChapter => "יתווסף כאן פרק",
        AgentOperationKind.RenameChapter => $"שם הפרק ישתנה ל-{operation.ChapterName}",
        AgentOperationKind.UpdateMetadata => "נתוני הסצנה יעודכנו",
        _ => "שינוי מבני מוצע"
    };
    private SceneEditorModel? FindScene(string sceneId) => Scenes.FirstOrDefault(scene => scene.Id == sceneId);
    private ChapterEditorGroup? FindChapterForScene(string sceneId) => ChapterGroups.FirstOrDefault(chapter => chapter.Scenes.Any(scene => scene.Id == sceneId));
    private bool IsSceneMetadataOpen(SceneEditorModel scene) => OpenMetadataSceneId == scene.Id;
    private void ToggleSceneMetadata(SceneEditorModel scene) => OpenMetadataSceneId = IsSceneMetadataOpen(scene) ? null : scene.Id;
    private void CloseSceneMetadata() => OpenMetadataSceneId = null;
    private List<CharacterIndexEntry> GetSceneCharacterEntities(SceneEditorModel scene)
    {
        if (!SceneMetadata.TryGetValue(scene.Id, out var metadata)) return [];
        var byId = (CharactersIndex.Characters ?? []).ToDictionary(character => character.Id, StringComparer.Ordinal);
        return (metadata.CharacterIds ?? []).Where(byId.ContainsKey).Select(id => byId[id]).ToList();
    }
    private List<EntityIndexEntry> GetSceneLocationEntities(SceneEditorModel scene)
    {
        if (!SceneMetadata.TryGetValue(scene.Id, out var metadata)) return [];
        var byId = (LocationsIndex.Entities ?? []).ToDictionary(location => location.Id, StringComparer.Ordinal);
        return (metadata.LocationIds ?? []).Where(byId.ContainsKey).Select(id => byId[id]).ToList();
    }
    private List<string> GetSceneCharacters(SceneEditorModel scene) => CharactersIndex.Characters.Where(character => character.SceneIds.Contains(scene.Id, StringComparer.Ordinal)).Select(character => character.Name).OrderBy(name => name, StringComparer.Ordinal).ToList();
    private string MetadataLockLabel(SceneEditorModel scene, string field)
    {
        if (!SceneMetadata.TryGetValue(scene.Id, out var metadata)) return "";
        var locked = field switch
        {
            "characters" => metadata.Locks?.Characters == true,
            "locations" => metadata.Locks?.Locations == true,
            "time" => metadata.Locks?.Time == true,
            _ => false
        };
        return locked ? "· ידני" : "· אוטומטי";
    }

    private string TimelineDescription(SceneEditorModel scene)
    {
        var position = TimelineIndex.Entries.FindIndex(entry => entry.SceneId == scene.Id);
        var confidence = SceneMetadata.GetValueOrDefault(scene.Id)?.Time?.Confidence ?? "unknown";
        var confidenceText = confidence switch { "high" => "ודאות גבוהה", "medium" => "ודאות בינונית", "low" => "ודאות נמוכה", "manual" => "הוגדר ידנית", _ => "טרם נותח" };
        return position < 0 ? confidenceText : $"מיקום {position + 1} בציר הזמן · {confidenceText}";
    }
    private static string ConfidenceLabel(string confidence) => confidence switch
    {
        "high" => "ודאות גבוהה",
        "medium" => "ודאות בינונית",
        "low" => "ודאות נמוכה",
        "manual" => "ידני",
        _ => "טרם נותח"
    };
    private static string GetSceneNavTitle(SceneEditorModel scene) { const int maxLength = 24; var title = scene.DisplayTitle.Trim(); return title.Length <= maxLength ? title : $"{title[..maxLength]}..."; }
    private static string FormatDuration(TimeSpan duration) => duration.TotalSeconds < 0.01
        ? "< 0.01 שנ׳"
        : $"{duration.TotalSeconds:0.00} שנ׳";

    public async ValueTask DisposeAsync()
    {
        ComponentCancellation.Cancel();
        if (DotNetReference is not null)
        {
            try { await FlushAll(); } catch (JSDisconnectedException) { }
        }
        DotNetReference?.Dispose();
        ComponentCancellation.Dispose();
        ProjectActivity.UnregisterEditor();
        if (ProjectActivity.ActiveEditors == 0) SnapshotCoordinator.RequestSnapshot();
    }

    private sealed class ChapterEditorGroup
    {
        public string Name { get; set; } = "";
        public string FirstSceneId { get; set; } = "";
        public List<SceneEditorModel> Scenes { get; set; } = [];
    }

    private sealed record MetadataAnalysisTimingDisplay(
        string SceneId,
        TimeSpan TotalDuration,
        TimeSpan PreparationDuration,
        TimeSpan AiDuration,
        TimeSpan IndexUpdateDuration,
        TimeSpan EditorReloadDuration);

    private enum SidebarMode
    {
        Scenes,
        Characters,
        Locations,
        Timeline,
        Display
    }
